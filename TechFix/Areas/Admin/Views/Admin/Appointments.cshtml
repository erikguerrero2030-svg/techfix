@{ Layout = "_Layout"; }
@model IEnumerable<Appointment>
@{ ViewData["Title"]="Gestionar citas"; }
<section class="container page-section admin-shell"><partial name="_AdminNav" /><div class="admin-main"><div class="page-heading"><div><span class="kicker">SOLICITUDES</span><h1>Citas y reparaciones</h1></div></div><form method="get" class="filter-bar"><input name="search" value="@ViewBag.Search" placeholder="Buscar código, cliente o correo" /><select name="status"><option value="">Todos los estados</option>@foreach(var value in Enum.GetValues<AppointmentStatus>()){<option value="@value" selected="@(ViewBag.Status == value)">@value</option>}</select><button class="btn-primary-tech" type="submit">Buscar</button></form><div class="table-wrap"><table class="tech-table"><thead><tr><th>Código</th><th>Cliente</th><th>Equipo</th><th>Fecha</th><th>Estado</th><th>Técnico</th><th>Acciones</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.TrackingCode</td><td>@a.Client.FullName<br /><small>@a.Client.Email</small></td><td>@a.Device.Brand @a.Device.Model</td><td>@a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td><td>@a.Status / @a.Repair?.State</td><td>@(a.Repair?.Technician?.FullName ?? "Sin asignar")</td><td><div class="table-actions vertical">@if(a.Status==AppointmentStatus.Pending){<form asp-action="Confirm" asp-route-id="@a.Id" method="post"><button type="submit">Confirmar</button></form>}@if(a.Status==AppointmentStatus.Confirmed && a.Repair is not null){<form asp-action="Assign" asp-route-id="@a.Repair.Id" method="post"><select name="technicianId" required><option value="">Asignar técnico</option>@foreach(var t in ViewBag.Technicians){<option value="@t.UserId">@t.User.FullName</option>}</select><button type="submit">Asignar</button></form>}@if(a.Repair?.State>=RepairState.RepairCompleted && a.Repair?.State!=RepairState.Cancelled){<a asp-action="Payments" asp-route-repairId="@a.Repair!.Id">Registrar pago</a>}</div></td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="empty-state">Sin resultados.</td></tr>}</tbody></table></div></div></section>

