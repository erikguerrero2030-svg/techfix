@{ Layout = "_Layout"; }
@model IEnumerable<ServiceItem>
@{ ViewData["Title"]="Servicios y precios"; }
<section class="container page-section admin-shell"><partial name="_AdminNav" /><div class="admin-main"><div class="page-heading"><div><span class="kicker">CATÁLOGO</span><h1>Servicios y precios</h1></div><a asp-action="Service" class="btn-primary-tech">Nuevo servicio</a></div><div class="table-wrap"><table class="tech-table"><thead><tr><th>Servicio</th><th>Descripción</th><th>Precio</th><th>Visible</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.Name</strong></td><td>@s.Description</td><td>$@s.Price.ToString("0.00")</td><td>@(s.IsActive?"Sí":"No")</td><td><a asp-action="Service" asp-route-id="@s.Id">Editar</a></td></tr>}</tbody></table></div></div></section>
