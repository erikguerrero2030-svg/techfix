@{ Layout = "_Layout"; }
@model IEnumerable<Appointment>
@{ ViewData["Title"]="Panel administrador"; }
<section class="container page-section admin-shell"><partial name="_AdminNav" /><div class="admin-main"><div class="page-heading"><div><span class="kicker">PANEL DE CONTROL</span><h1>TechFix en tiempo real</h1><p>Datos calculados desde las reservas y pagos registrados.</p></div></div><div class="stat-grid"><div class="stat-card"><span>Clientes</span><strong>@ViewBag.Clients</strong></div><div class="stat-card"><span>Citas pendientes</span><strong>@ViewBag.Pending</strong></div><div class="stat-card"><span>En proceso</span><strong>@ViewBag.InProcess</strong></div><div class="stat-card"><span>Finalizadas</span><strong>@ViewBag.Finished</strong></div><div class="stat-card"><span>Ingresos registrados</span><strong>$@ViewBag.Revenue</strong></div><div class="stat-card"><span>Técnicos activos</span><strong>@ViewBag.Technicians</strong></div></div><div class="panel"><div class="panel-head"><h2>Solicitudes recientes</h2><a asp-action="Appointments">Ver todas</a></div><div class="table-wrap"><table class="tech-table"><thead><tr><th>Código</th><th>Cliente</th><th>Servicio</th><th>Estado</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.TrackingCode</td><td>@a.Client.FullName</td><td>@a.ServiceItem.Name</td><td><span class="status-pill">@a.Status</span></td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="empty-state">Aún no hay solicitudes.</td></tr>}</tbody></table></div></div></div></section>
