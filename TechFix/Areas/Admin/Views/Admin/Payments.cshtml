@model IEnumerable<Payment>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Pagos";
    var payableRepairs = (IEnumerable<Repair>)ViewBag.PayableRepairs;
}
<section class="container page-section admin-shell">
    <partial name="_AdminNav" />
    <div class="admin-main">
        <div class="page-heading"><div><span class="kicker">FINANZAS</span><h1>Pagos registrados</h1></div></div>
        <div class="panel">
            <h2>Registrar ingreso</h2>
            <p>Selecciona una reparación terminada o entregada.</p>
            <form asp-action="Payment" method="post" class="filter-bar">
                <select name="repairId" aria-label="Reparación" required>
                    <option value="">Selecciona una reparación</option>
                    @foreach (var repair in payableRepairs)
                    {
                        <option value="@repair.Id" selected="@(ViewBag.SelectedRepairId == repair.Id)">@repair.Appointment.TrackingCode — @repair.Appointment.Client.FullName (ID @repair.Id)</option>
                    }
                </select>
                <input type="number" name="amount" min="0.01" step="0.01" placeholder="Monto" aria-label="Monto" required />
                <select name="method" aria-label="Método de pago" required>
                    <option value="Efectivo">Efectivo</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
                <button class="btn-primary-tech" type="submit" @(payableRepairs.Any() ? null : "disabled")>Registrar pago</button>
            </form>
            @if (!payableRepairs.Any()) { <p>No hay reparaciones listas para registrar un pago.</p> }
        </div>
        <div class="table-wrap">
            <table class="tech-table">
                <thead><tr><th>Reparación</th><th>Código</th><th>Monto</th><th>Método</th><th>Fecha</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr><td>@p.RepairId</td><td>@p.Repair.Appointment.TrackingCode</td><td>$@p.Amount.ToString("0.00")</td><td>@p.Method</td><td>@p.RegisteredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                    }
                    @if (!Model.Any()) { <tr><td colspan="5" class="empty-state">Aún no se han registrado pagos.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</section>
