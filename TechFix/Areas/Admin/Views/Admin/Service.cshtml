@{ Layout = "_Layout"; }
@model ServiceVm
@{ ViewData["Title"]=Model.Id==0?"Nuevo servicio":"Editar servicio"; }
<section class="container page-section admin-shell"><partial name="_AdminNav" /><div class="admin-main"><div class="page-heading"><div><span class="kicker">CATÁLOGO</span><h1>@ViewData["Title"]</h1></div></div><div class="form-card"><form asp-action="Service" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Name">Nombre</label><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span><label asp-for="Description">Descripción</label><textarea asp-for="Description" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span><label asp-for="Price">Precio</label><input asp-for="Price" type="number" step="0.01" min="0" /><span asp-validation-for="Price" class="text-danger"></span><div class="check-line"><input asp-for="IsActive" /><label asp-for="IsActive">Visible al público</label></div><button class="btn-primary-tech" type="submit">Guardar servicio</button></form></div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
