@{ Layout = "_Layout"; }
@model IEnumerable<ReportMonthVm>
@{ ViewData["Title"]="Reportes"; }
<section class="container page-section admin-shell"><partial name="_AdminNav" /><div class="admin-main"><div class="page-heading"><div><span class="kicker">ANÁLISIS</span><h1>Reportes</h1><p>Los indicadores provienen de los registros reales del sistema.</p></div></div><div class="stat-grid"><div class="stat-card"><span>Equipos reparados</span><strong>@ViewBag.Completed</strong></div><div class="stat-card"><span>Equipos recuperados y entregados</span><strong>@ViewBag.Recovered</strong></div><div class="stat-card"><span>Valoraciones</span><strong>@ViewBag.Reviews</strong></div><div class="stat-card"><span>Puntuación media</span><strong>@(((double)ViewBag.AverageRating).ToString("0.0")) / 5</strong></div></div><div class="panel"><h2>Ingresos por mes</h2>@if(!Model.Any()){<p>No hay pagos registrados.</p>}else{<div class="report-bars">@foreach(var item in Model){<div><span>@item.Month/@item.Year</span><div class="bar-track"><div class="bar-fill" style="width:@Math.Min(100,(double)item.Total/(double)ViewBag.MaxMonthly*100).ToString("0")%"></div></div><strong>$@item.Total</strong></div>}</div>}</div></div></section>
