@model RegisterVm
@{ ViewData["Title"]="Crear cuenta"; }
<section class="container auth-wrap"><div class="auth-copy"><span class="kicker">BIENVENIDO A TECHFIX</span><h1>Empieza a cuidar tu equipo.</h1><p>Tu cuenta de cliente te permite reservar citas, autorizar reparaciones y consultar tu historial.</p></div><div class="form-card"><h2>Crear cuenta</h2><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="text-danger"></span><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="btn-primary-tech w-100" type="submit">Crear cuenta</button></form><p class="form-foot">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
