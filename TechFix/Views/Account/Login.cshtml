@model LoginVm
@{ ViewData["Title"]="Iniciar sesión"; }
<section class="container auth-wrap"><div class="auth-copy"><span class="kicker">ACCESO SEGURO</span><h1>Retoma el control de tu equipo.</h1><p>Consulta tus citas y el estado de tus reparaciones en un solo lugar.</p></div><div class="form-card"><h2>Iniciar sesión</h2><form asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password"></label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span><div class="check-line"><input asp-for="RememberMe" /><label asp-for="RememberMe">Recordarme</label></div><button class="btn-primary-tech w-100" type="submit">Entrar</button></form><p class="form-foot">¿No tienes cuenta? <a asp-action="Register">Regístrate</a></p></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
