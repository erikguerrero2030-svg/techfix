@model AppointmentVm
@{ ViewData["Title"]="Agendar cita"; }
<section class="container page-section"><div class="page-heading"><div><span class="kicker">AGENDA TU VISITA</span><h1>Cuéntanos sobre tu equipo</h1><p>Selecciona una hora en punto dentro del horario de atención.</p></div></div><div class="form-card wide-form"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-grid"><div><label>Nombre del cliente</label><input value="@ViewBag.ClientName" readonly /></div><div><label>Correo electrónico</label><input value="@ViewBag.ClientEmail" readonly /></div><div><label asp-for="DeviceType"></label><input asp-for="DeviceType" placeholder="Laptop, PC de escritorio..." /><span asp-validation-for="DeviceType" class="text-danger"></span></div><div><label asp-for="Brand">Marca</label><input asp-for="Brand" placeholder="Ej. Lenovo" /><span asp-validation-for="Brand" class="text-danger"></span></div><div><label asp-for="Model">Modelo</label><input asp-for="Model" placeholder="Ej. IdeaPad" /><span asp-validation-for="Model" class="text-danger"></span></div><div><label asp-for="Phone">Teléfono</label><input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone" class="text-danger"></span></div><div><label asp-for="ServiceItemId">Servicio</label><select asp-for="ServiceItemId" asp-items="ViewBag.Services"><option value="">Selecciona un servicio</option></select><span asp-validation-for="ServiceItemId" class="text-danger"></span></div><div><label asp-for="ScheduledAt">Fecha y hora</label><input asp-for="ScheduledAt" type="datetime-local" step="3600" /><span asp-validation-for="ScheduledAt" class="text-danger"></span></div><div class="full"><label asp-for="Problem">Describe el problema</label><textarea asp-for="Problem" rows="4" placeholder="¿Qué ocurre con el equipo?"></textarea><span asp-validation-for="Problem" class="text-danger"></span></div></div><button class="btn-primary-tech" type="submit">Confirmar solicitud</button></form></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
