@model IEnumerable<Appointment>
@{ ViewData["Title"]="Mis citas"; }
<section class="container page-section"><div class="page-heading"><div><span class="kicker">ÁREA DE CLIENTE</span><h1>Mis citas</h1><p>Consulta tus reservas y el avance de cada reparación.</p></div><a asp-action="Create" class="btn-primary-tech">Nueva cita</a></div>
<div class="table-wrap"><table class="tech-table"><thead><tr><th>Código</th><th>Equipo</th><th>Servicio</th><th>Fecha</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var a in Model) { <tr><td><strong>@a.TrackingCode</strong></td><td>@a.Device.Brand @a.Device.Model</td><td>@a.ServiceItem.Name</td><td>@a.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</td><td><span class="status-pill">@(a.Status == AppointmentStatus.Pending ? "Pendiente" : a.Status == AppointmentStatus.Confirmed ? "Confirmada" : "Cancelada")</span></td><td><div class="table-actions"><a asp-controller="Repairs" asp-action="Details" asp-route-id="@a.Repair?.Id">Seguimiento</a>@if(a.Status==AppointmentStatus.Pending){<form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('¿Cancelar esta cita?')"><button type="submit" class="link-danger">Cancelar</button></form>}</div></td></tr> }
@if(!Model.Any()) { <tr><td colspan="6" class="empty-state">Aún no tienes citas. <a asp-action="Create">Agenda la primera.</a></td></tr> }
</tbody></table></div></section>
