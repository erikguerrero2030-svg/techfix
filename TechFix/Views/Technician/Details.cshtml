@model Repair
@{ ViewData["Title"]="Trabajo técnico"; RepairState? next = Model.State switch { RepairState.AppointmentConfirmed=>RepairState.DeviceReceived, RepairState.DeviceReceived=>RepairState.Diagnosing, RepairState.Diagnosing=>RepairState.AwaitingClientApproval, RepairState.Repairing=>RepairState.RepairCompleted, RepairState.RepairCompleted=>RepairState.DeviceDelivered, _=>null }; }
<section class="container page-section"><div class="page-heading"><div><span class="kicker">ORDEN · @Model.Appointment.TrackingCode</span><h1>@Model.Appointment.Device.Brand @Model.Appointment.Device.Model</h1><p>@Model.Appointment.Problem</p></div><span class="status-pill large">@Model.State</span></div><div class="content-grid"><div class="panel"><h2>Actualizar trabajo</h2>@if(next is not null){<form asp-action="Update" method="post"><input type="hidden" name="RepairId" value="@Model.Id" /><input type="hidden" name="State" value="@((int)next.Value)" /><p>Próximo estado: <b>@next</b></p><label for="notes">Observaciones</label><textarea id="notes" name="Notes" maxlength="2000" rows="3"></textarea>@if(next==RepairState.AwaitingClientApproval){<label for="findings">Diagnóstico</label><textarea id="findings" name="Findings" required maxlength="2000" rows="4"></textarea><label for="action">Acción propuesta</label><textarea id="action" name="ProposedAction" maxlength="2000" rows="3"></textarea>}<div class="form-grid"><div><label for="component">Componente utilizado (opcional)</label><input id="component" name="ComponentName" maxlength="100" /></div><div><label for="quantity">Cantidad</label><input id="quantity" name="Quantity" type="number" value="1" min="1" /></div><div><label for="cost">Costo unitario</label><input id="cost" name="UnitCost" type="number" value="0" min="0" step="0.01" /></div></div><button class="btn-primary-tech" type="submit">Registrar avance</button></form>}else{<p>Esperando autorización del cliente o trabajo finalizado.</p>}</div><aside class="panel"><h2>Historial</h2><ol class="timeline">@foreach(var h in Model.History.OrderBy(x=>x.ChangedAt)){<li><strong>@h.State</strong><span>@h.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><p>@h.Notes</p></li>}</ol>@if(Model.Components.Any()){<h3>Componentes</h3><ul>@foreach(var c in Model.Components){<li>@c.Name · @c.Quantity × $@c.UnitCost</li>}</ul>}</aside></div></section>
