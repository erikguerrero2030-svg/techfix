@model IEnumerable<Repair>
@{ ViewData["Title"]="Mis reparaciones"; }
<section class="container page-section"><div class="page-heading"><div><span class="kicker">PANEL TÉCNICO</span><h1>Reparaciones asignadas</h1><p>Registra diagnósticos y avances de tus equipos.</p></div></div><div class="table-wrap"><table class="tech-table"><thead><tr><th>Código</th><th>Equipo</th><th>Servicio</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Appointment.TrackingCode</td><td>@r.Appointment.Device.Brand @r.Appointment.Device.Model</td><td>@r.Appointment.ServiceItem.Name</td><td><span class="status-pill">@r.State</span></td><td><a asp-action="Details" asp-route-id="@r.Id">Abrir</a></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="empty-state">No tienes reparaciones asignadas.</td></tr>}</tbody></table></div></section>
