@model Repair
@{ ViewData["Title"]="Seguimiento"; }
<section class="container page-section"><div class="page-heading"><div><span class="kicker">SEGUIMIENTO · @Model.Appointment.TrackingCode</span><h1>@Model.Appointment.Device.Brand @Model.Appointment.Device.Model</h1><p>@Model.Appointment.ServiceItem.Name · @Model.Appointment.ScheduledAt.ToString("dd/MM/yyyy HH:mm")</p></div><span class="status-pill large">@Model.State</span></div>
<div class="content-grid"><div class="panel"><h2>Progreso de la reparación</h2><ol class="timeline">@foreach(var item in Model.History.OrderBy(x=>x.ChangedAt)){<li><strong>@item.State</strong><span>@item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.ChangedBy.FullName</span><p>@item.Notes</p></li>}</ol></div><aside class="panel"><h2>Detalles</h2><p><b>Problema:</b> @Model.Appointment.Problem</p><p><b>Estado:</b> @Model.State</p>@if(Model.Diagnoses.Any()){<h3>Diagnóstico</h3>@foreach(var d in Model.Diagnoses.OrderByDescending(x=>x.CreatedAt)){<p>@d.Findings</p><p><b>Propuesta:</b> @d.ProposedAction</p>}}
@if(Model.State==RepairState.AwaitingClientApproval){<form asp-action="Approve" asp-route-id="@Model.Id" method="post"><button class="btn-primary-tech" type="submit">Autorizar reparación</button></form>}
@if(Model.State==RepairState.DeviceDelivered && Model.Review is null){<h3>Califica el servicio</h3><form asp-action="Review" asp-route-id="@Model.Id" method="post"><label for="rating">Puntuación</label><select id="rating" name="rating" required><option value="5">5 estrellas</option><option value="4">4 estrellas</option><option value="3">3 estrellas</option><option value="2">2 estrellas</option><option value="1">1 estrella</option></select><label for="comment">Comentario</label><textarea id="comment" name="comment" maxlength="1000"></textarea><button class="btn-primary-tech" type="submit">Enviar valoración</button></form>}
@if(Model.Review is not null){<p>Valoración registrada: @Model.Review.Rating / 5</p>}
</aside></div></section>
